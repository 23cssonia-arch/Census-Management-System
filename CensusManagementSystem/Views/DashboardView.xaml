<Page x:Class="CensusManagementSystem.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Statistics Cards -->
        <UniformGrid Grid.Row="0" Rows="1" Margin="0,0,0,15">
            <!-- Total Households -->
            <Border Margin="0,0,8,0" Background="#1A3C5E" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="Total Households" FontSize="12" Foreground="#AED6F1"
                               FontFamily="Segoe UI" Margin="0,0,0,8"/>
                    <TextBlock x:Name="LblHouseholds" Text="0" FontSize="36" FontWeight="Bold"
                               Foreground="White" FontFamily="Segoe UI"/>
                    <TextBlock Text="households registered" FontSize="10" Foreground="#5DADE2"
                               FontFamily="Segoe UI" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Total Population -->
            <Border Margin="8,0,8,0" Background="#1A3C5E" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="Total Population" FontSize="12" Foreground="#AED6F1"
                               FontFamily="Segoe UI" Margin="0,0,0,8"/>
                    <TextBlock x:Name="LblPopulation" Text="0" FontSize="36" FontWeight="Bold"
                               Foreground="White" FontFamily="Segoe UI"/>
                    <TextBlock Text="citizens recorded" FontSize="10" Foreground="#5DADE2"
                               FontFamily="Segoe UI" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Male Population -->
            <Border Margin="8,0,8,0" Background="#1A3C5E" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="Male Population" FontSize="12" Foreground="#AED6F1"
                               FontFamily="Segoe UI" Margin="0,0,0,8"/>
                    <TextBlock x:Name="LblMale" Text="0" FontSize="36" FontWeight="Bold"
                               Foreground="#5DADE2" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="LblMalePercent" Text="0% of total" FontSize="10" Foreground="#5DADE2"
                               FontFamily="Segoe UI" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Female Population -->
            <Border Margin="8,0,0,0" Background="#1A3C5E" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="Female Population" FontSize="12" Foreground="#AED6F1"
                               FontFamily="Segoe UI" Margin="0,0,0,8"/>
                    <TextBlock x:Name="LblFemale" Text="0" FontSize="36" FontWeight="Bold"
                               Foreground="#E8739A" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="LblFemalePercent" Text="0% of total" FontSize="10" Foreground="#E8739A"
                               FontFamily="Segoe UI" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Bottom Section - Recent Records & Quick Stats -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Recent Citizens -->
            <Border Grid.Column="0" Background="#1A3C5E" CornerRadius="12" Margin="0,0,8,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="Recent Citizens" FontSize="14" FontWeight="SemiBold"
                               Foreground="White" FontFamily="Segoe UI" Margin="0,0,0,10"/>
                    <DataGrid x:Name="DgRecentCitizens" AutoGenerateColumns="False"
                              HeadersVisibility="Column" Background="Transparent"
                              RowBackground="#0F2B46" AlternatingRowBackground="#132E4A"
                              Foreground="White" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1A3C5E" IsReadOnly="True"
                              SelectionMode="Single" FontFamily="Segoe UI" FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="CNIC" Binding="{Binding CNIC}" Width="120"/>
                            <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Summary Stats -->
            <Border Grid.Column="1" Background="#1A3C5E" CornerRadius="12" Margin="8,0,0,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="Quick Statistics" FontSize="14" FontWeight="SemiBold"
                               Foreground="White" FontFamily="Segoe UI" Margin="0,0,0,15"/>

                    <!-- Province Count -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Provinces" FontSize="12" Foreground="#AED6F1" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="LblProvinces" Grid.Column="1" Text="0" FontSize="14"
                                   FontWeight="Bold" Foreground="#5DADE2" FontFamily="Segoe UI"/>
                    </Grid>
                    <Rectangle Height="1" Fill="#1A5276" Margin="0,0,0,10"/>

                    <!-- District Count -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Districts" FontSize="12" Foreground="#AED6F1" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="LblDistricts" Grid.Column="1" Text="0" FontSize="14"
                                   FontWeight="Bold" Foreground="#5DADE2" FontFamily="Segoe UI"/>
                    </Grid>
                    <Rectangle Height="1" Fill="#1A5276" Margin="0,0,0,10"/>

                    <!-- Tehsil Count -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tehsils" FontSize="12" Foreground="#AED6F1" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="LblTehsils" Grid.Column="1" Text="0" FontSize="14"
                                   FontWeight="Bold" Foreground="#5DADE2" FontFamily="Segoe UI"/>
                    </Grid>
                    <Rectangle Height="1" Fill="#1A5276" Margin="0,0,0,10"/>

                    <!-- Union Councils -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Union Councils" FontSize="12" Foreground="#AED6F1" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="LblUCs" Grid.Column="1" Text="0" FontSize="14"
                                   FontWeight="Bold" Foreground="#5DADE2" FontFamily="Segoe UI"/>
                    </Grid>
                    <Rectangle Height="1" Fill="#1A5276" Margin="0,0,0,10"/>

                    <!-- Census Blocks -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Census Blocks" FontSize="12" Foreground="#AED6F1" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="LblBlocks" Grid.Column="1" Text="0" FontSize="14"
                                   FontWeight="Bold" Foreground="#5DADE2" FontFamily="Segoe UI"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
