<Page x:Class="CensusManagementSystem.Views.AreaManagementView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Area Management">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab Control for Area Hierarchy -->
        <TabControl Grid.Row="0" Grid.RowSpan="2" Background="Transparent" BorderThickness="0"
                    FontFamily="Segoe UI" Margin="0,0,0,0">

            <!-- Province Tab -->
            <TabItem Header="  Provinces  " Background="#1A3C5E" Foreground="White" FontSize="12">
                <TabItem.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TabItem.Resources>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Add Province -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="TxtProvinceName" Width="250" Height="36" FontSize="13"
                                 FontFamily="Segoe UI" Padding="10,0,0,0" VerticalContentAlignment="Center"
                                 Background="#1A3C5E" Foreground="White" BorderThickness="0"
                                 CaretBrush="#5DADE2">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <Button x:Name="BtnAddProvince" Content="Add Province" Height="36" FontSize="12"
                                FontWeight="SemiBold" Background="#27AE60" Foreground="White"
                                BorderThickness="0" Margin="10,0,0,0" Padding="15,0"
                                Click="BtnAddProvince_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnUpdateProvince" Content="Update" Height="36" FontSize="12"
                                FontWeight="SemiBold" Background="#F39C12" Foreground="White"
                                BorderThickness="0" Margin="5,0,0,0" Padding="15,0"
                                Click="BtnUpdateProvince_Click" Cursor="Hand" Visibility="Collapsed">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnCancelProvince" Content="Cancel" Height="36" FontSize="12"
                                Background="#7F8C8D" Foreground="White"
                                BorderThickness="0" Margin="5,0,0,0" Padding="15,0"
                                Click="BtnCancelProvince_Click" Cursor="Hand" Visibility="Collapsed">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                    <!-- DataGrid -->
                    <DataGrid x:Name="DgProvinces" Grid.Row="1" AutoGenerateColumns="False"
                              Background="Transparent" RowBackground="white"
                             Foreground="#132E4A"
                              BorderThickness="0" GridLinesVisibility="Horizontal"
                             IsReadOnly="True"
                              SelectionMode="Single" FontFamily="Segoe UI" FontSize="12"
                              SelectionChanged="DgProvinces_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ProvinceId}" Width="60"/>
                            <DataGridTextColumn Header="Province Name" Binding="{Binding ProvinceName}" Width="*"/>
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Delete" FontSize="10" Background="#922B21"
                                                Foreground="White" BorderThickness="0" Padding="8,2"
                                                Click="BtnDeleteProvince_Click" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- District Tab -->
            <TabItem Header="  Districts  " Background="#1A3C5E" Foreground="White" FontSize="12">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox x:Name="CmbDistrictProvince" Width="180" Height="36" FontSize="12"
                                  DisplayMemberPath="ProvinceName" Background="#1A3C5E"
                                  Foreground="White" BorderThickness="0"
                                  SelectionChanged="CmbDistrictProvince_SelectionChanged">
                            <ComboBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </ComboBox.Resources>
                        </ComboBox>
                        <TextBox x:Name="TxtDistrictName" Width="200" Height="36" FontSize="13"
                                 FontFamily="Segoe UI" Padding="10,0,0,0" VerticalContentAlignment="Center"
                                 Background="#1A3C5E" Foreground="White" BorderThickness="0"
                                 CaretBrush="#5DADE2" Margin="10,0,0,0">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <Button Content="Add District" Height="36" FontSize="12" FontWeight="SemiBold"
                                Background="#27AE60" Foreground="White" BorderThickness="0"
                                Margin="10,0,0,0" Padding="15,0" Click="BtnAddDistrict_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                    <DataGrid x:Name="DgDistricts" Grid.Row="1" AutoGenerateColumns="False"
                              Background="Transparent" RowBackground="#0F2B46"
                              AlternatingRowBackground="#132E4A" Foreground="#132E4A"
                              BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1A3C5E" IsReadOnly="True"
                              SelectionMode="Single" FontFamily="Segoe UI" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding DistrictId}" Width="60"/>
                            <DataGridTextColumn Header="District Name" Binding="{Binding DistrictName}" Width="*"/>
                            <DataGridTextColumn Header="Province" Binding="{Binding ProvinceName}" Width="150"/>
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Delete" FontSize="10" Background="#922B21"
                                                Foreground="White" BorderThickness="0" Padding="8,2"
                                                Click="BtnDeleteDistrict_Click" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tehsil Tab -->
            <TabItem Header="  Tehsils  " Background="#1A3C5E" Foreground="White" FontSize="12">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox x:Name="CmbTehsilDistrict" Width="180" Height="36" FontSize="12"
                                  DisplayMemberPath="DistrictName" Background="#1A3C5E"
                                  Foreground="#132E4A" BorderThickness="0"
                                  SelectionChanged="CmbTehsilDistrict_SelectionChanged">
                            <ComboBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </ComboBox.Resources>
                        </ComboBox>
                        <TextBox x:Name="TxtTehsilName" Width="200" Height="36" FontSize="13"
                                 FontFamily="Segoe UI" Padding="10,0,0,0" VerticalContentAlignment="Center"
                                 Background="#1A3C5E" Foreground="White" BorderThickness="0"
                                 CaretBrush="#5DADE2" Margin="10,0,0,0">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <Button Content="Add Tehsil" Height="36" FontSize="12" FontWeight="SemiBold"
                                Background="#27AE60" Foreground="White" BorderThickness="0"
                                Margin="10,0,0,0" Padding="15,0" Click="BtnAddTehsil_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                    <DataGrid x:Name="DgTehsils" Grid.Row="1" AutoGenerateColumns="False"
                              Background="Transparent" RowBackground="white"
                              AlternatingRowBackground="white" Foreground="#132E4A"
                              BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1A3C5E" IsReadOnly="True"
                              SelectionMode="Single" FontFamily="Segoe UI" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding TehsilId}" Width="60"/>
                            <DataGridTextColumn Header="Tehsil Name" Binding="{Binding TehsilName}" Width="*"/>
                            <DataGridTextColumn Header="District" Binding="{Binding DistrictName}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Union Council Tab -->
            <TabItem Header="  Union Councils  " Background="#1A3C5E" Foreground="White" FontSize="12">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox x:Name="CmbUCTehsil" Width="180" Height="36" FontSize="12"
                                  DisplayMemberPath="TehsilName" Background="#1A3C5E"
                                  Foreground="White" BorderThickness="0"
                                  SelectionChanged="CmbUCTehsil_SelectionChanged">
                            <ComboBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </ComboBox.Resources>
                        </ComboBox>
                        <TextBox x:Name="TxtUCName" Width="200" Height="36" FontSize="13"
                                 FontFamily="Segoe UI" Padding="10,0,0,0" VerticalContentAlignment="Center"
                                 Background="#1A3C5E" Foreground="White" BorderThickness="0"
                                 CaretBrush="#5DADE2" Margin="10,0,0,0">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <Button Content="Add UC" Height="36" FontSize="12" FontWeight="SemiBold"
                                Background="#27AE60" Foreground="White" BorderThickness="0"
                                Margin="10,0,0,0" Padding="15,0" Click="BtnAddUC_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                    <DataGrid x:Name="DgUnionCouncils" Grid.Row="1" AutoGenerateColumns="False"
                              Background="Transparent" RowBackground="white"
                              AlternatingRowBackground="#132E4A" Foreground="#132E4A"
                              BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1A3C5E" IsReadOnly="True"
                              SelectionMode="Single" FontFamily="Segoe UI" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding UnionCouncilId}" Width="60"/>
                            <DataGridTextColumn Header="UC Name" Binding="{Binding UnionCouncilName}" Width="*"/>
                            <DataGridTextColumn Header="Tehsil" Binding="{Binding TehsilName}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Census Block Tab -->
            <TabItem Header="  Census Blocks  " Background="#1A3C5E" Foreground="White" FontSize="12">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="CmbBlockUC" Width="180" Height="36" FontSize="12"
                                      DisplayMemberPath="UnionCouncilName" Background="#1A3C5E"
                                      Foreground="White" BorderThickness="0"
                                      SelectionChanged="CmbBlockUC_SelectionChanged">
                                <ComboBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </ComboBox.Resources>
                            </ComboBox>
                            <TextBox x:Name="TxtBlockCode" Width="100" Height="36" FontSize="13"
                                     FontFamily="Segoe UI" Padding="10,0,0,0" VerticalContentAlignment="Center"
                                     Background="#1A3C5E" Foreground="White" BorderThickness="0"
                                     CaretBrush="#5DADE2" Margin="10,0,0,0">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <TextBox x:Name="TxtBlockName" Width="160" Height="36" FontSize="13"
                                     FontFamily="Segoe UI" Padding="10,0,0,0" VerticalContentAlignment="Center"
                                     Background="#1A3C5E" Foreground="White" BorderThickness="0"
                                     CaretBrush="#5DADE2" Margin="10,0,0,0">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <Button Content="Add Block" Height="36" FontSize="12" FontWeight="SemiBold"
                                    Background="#27AE60" Foreground="White" BorderThickness="0"
                                    Margin="10,0,0,0" Padding="15,0" Click="BtnAddBlock_Click" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="DgCensusBlocks" Grid.Row="1" AutoGenerateColumns="False"
                              Background="#132E4A" RowBackground="white"
                              AlternatingRowBackground="#132E4A" Foreground="#132E4A"
                              BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1A3C5E" IsReadOnly="True"
                              SelectionMode="Single" FontFamily="Segoe UI" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding CensusBlockId}" Width="60"/>
                            <DataGridTextColumn Header="Code" Binding="{Binding BlockCode}" Width="100"/>
                            <DataGridTextColumn Header="Block Name" Binding="{Binding BlockName}" Width="*"/>
                            <DataGridTextColumn Header="Union Council" Binding="{Binding UnionCouncilName}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
