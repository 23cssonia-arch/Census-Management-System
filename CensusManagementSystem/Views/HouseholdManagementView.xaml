<Page x:Class="CensusManagementSystem.Views.HouseholdManagementView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Household Management">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="TxtSearch" Width="300" Height="36" FontSize="13"
                     FontFamily="Segoe UI" Padding="10,0,0,0" VerticalContentAlignment="Center"
                     Background="#1A3C5E" Foreground="White" BorderThickness="0"
                     CaretBrush="#5DADE2" KeyDown="TxtSearch_KeyDown">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <Button Content="Search" Height="36" FontSize="12" FontWeight="SemiBold"
                    Background="#5DADE2" Foreground="White" BorderThickness="0"
                    Margin="10,0,0,0" Padding="15,0" Click="BtnSearch_Click" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Show All" Height="36" FontSize="12"
                    Background="#7F8C8D" Foreground="White" BorderThickness="0"
                    Margin="10,0,0,0" Padding="15,0" Click="BtnShowAll_Click" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <Border Grid.Row="1" Background="#1A3C5E" CornerRadius="12" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
                    <TextBlock Text="House Number" FontSize="11" Foreground="#AED6F1" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtHouseNumber" Height="34" FontSize="13" FontFamily="Segoe UI"
                             Padding="10,0,0,0" VerticalContentAlignment="Center"
                             Background="#0F2B46" Foreground="White" BorderThickness="0" CaretBrush="#5DADE2">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,8">
                    <TextBlock Text="Family Number" FontSize="11" Foreground="#AED6F1" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtFamilyNumber" Height="34" FontSize="13" FontFamily="Segoe UI"
                             Padding="10,0,0,0" VerticalContentAlignment="Center"
                             Background="#0F2B46" Foreground="White" BorderThickness="0" CaretBrush="#5DADE2">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,8">
                    <TextBlock Text="Head of Family" FontSize="11" Foreground="#AED6F1" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtHeadOfFamily" Height="34" FontSize="13" FontFamily="Segoe UI"
                             Padding="10,0,0,0" VerticalContentAlignment="Center"
                             Background="#0F2B46" Foreground="White" BorderThickness="0" CaretBrush="#5DADE2">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,8">
                    <TextBlock Text="Census Block ID" FontSize="11" Foreground="#AED6F1" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtCensusBlock" Height="34" FontSize="13" FontFamily="Segoe UI"
             Padding="10,0,0,0" VerticalContentAlignment="Center"
             Background="#0F2B46" Foreground="White" BorderThickness="0" CaretBrush="#5DADE2">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,10,8">
                    <TextBlock Text="Address" FontSize="11" Foreground="#AED6F1" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtAddress" Height="34" FontSize="13" FontFamily="Segoe UI"
                             Padding="10,0,0,0" VerticalContentAlignment="Center"
                             Background="#0F2B46" Foreground="White" BorderThickness="0" CaretBrush="#5DADE2">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,8">
                    <TextBlock Text="Family Members" FontSize="11" Foreground="#AED6F1" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNumMembers" Height="34" FontSize="13" FontFamily="Segoe UI"
                             Padding="10,0,0,0" VerticalContentAlignment="Center"
                             Background="#0F2B46" Foreground="White" BorderThickness="0" CaretBrush="#5DADE2">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                    <Button x:Name="BtnAdd" Content="Add Household" Height="34" FontSize="12" FontWeight="SemiBold"
                            Background="#27AE60" Foreground="White" BorderThickness="0"
                            Padding="15,0" Click="BtnAdd_Click" Cursor="Hand" Margin="0,0,5,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BtnUpdate" Content="Update" Height="34" FontSize="12" FontWeight="SemiBold"
                            Background="#F39C12" Foreground="White" BorderThickness="0"
                            Padding="15,0" Click="BtnUpdate_Click" Cursor="Hand" Visibility="Collapsed" Margin="0,0,5,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BtnCancel" Content="Cancel" Height="34" FontSize="12"
                            Background="#7F8C8D" Foreground="White" BorderThickness="0"
                            Padding="15,0" Click="BtnCancel_Click" Cursor="Hand" Visibility="Collapsed">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="DgHouseholds" Grid.Row="2" AutoGenerateColumns="False"
                  Background="Transparent" RowBackground="white"
                  AlternatingRowBackground="white" Foreground="#132E4A"
                  BorderThickness="0" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#1A3C5E" IsReadOnly="True"
                  SelectionMode="Single" FontFamily="Segoe UI" FontSize="12"
                  SelectionChanged="DgHouseholds_SelectionChanged">
            <DataGrid.Resources>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="#132E4A" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding HouseholdId}" Width="50"/>
                <DataGridTextColumn Header="House No" Binding="{Binding HouseNumber}" Width="80"/>
                <DataGridTextColumn Header="Family No" Binding="{Binding FamilyNumber}" Width="80"/>
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*"/>
                <DataGridTextColumn Header="Head of Family" Binding="{Binding HeadOfFamily}" Width="140"/>
                <DataGridTextColumn Header="Members" Binding="{Binding NumberOfFamilyMembers}" Width="65"/>
                <DataGridTextColumn Header="Block" Binding="{Binding BlockName}" Width="120"/>
                <DataGridTemplateColumn Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Delete" FontSize="10" Background="#922B21"
                                    Foreground="White" BorderThickness="0" Padding="6,2"
                                    Click="BtnDelete_Click" Cursor="Hand"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>