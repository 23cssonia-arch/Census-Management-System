<Window x:Class="CensusManagementSystem.Windows.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register - Census Management System"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Width="450" Height="620"
        ResizeMode="NoResize">

    <Border CornerRadius="15" Background="#0F2B46" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#0a1f33" BlurRadius="20" ShadowDepth="3" Opacity="0.8"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Border Width="50" Height="50" CornerRadius="25" Background="#1A5276" Margin="0,0,0,8">
                    <TextBlock Text="&#x1F465;" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Create Account" FontSize="22" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
            </StackPanel>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,10,40,0">
                    <!-- Full Name -->
                    <TextBlock Text="Full Name" FontSize="12" Foreground="#AED6F1"
                               FontFamily="Segoe UI" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtFullName" Height="40" FontSize="14"
                             FontFamily="Segoe UI" Padding="10,0,0,0" VerticalContentAlignment="Center"
                             Background="#1A3C5E" Foreground="White" BorderThickness="0"
                             CaretBrush="#5DADE2">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <!-- Username -->
                    <TextBlock Text="Username" FontSize="12" Foreground="#AED6F1"
                               FontFamily="Segoe UI" Margin="0,15,0,5"/>
                    <TextBox x:Name="TxtUsername" Height="40" FontSize="14"
                             FontFamily="Segoe UI" Padding="10,0,0,0" VerticalContentAlignment="Center"
                             Background="#1A3C5E" Foreground="White" BorderThickness="0"
                             CaretBrush="#5DADE2">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <!-- Password -->
                    <TextBlock Text="Password" FontSize="12" Foreground="#AED6F1"
                               FontFamily="Segoe UI" Margin="0,15,0,5"/>
                    <PasswordBox x:Name="TxtPassword" Height="40" FontSize="14"
                                 FontFamily="Segoe UI" Padding="10,0,0,0" VerticalContentAlignment="Center"
                                 Background="#1A3C5E" Foreground="White" BorderThickness="0"
                                 PasswordChar="*" CaretBrush="#5DADE2">
                        <PasswordBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </PasswordBox.Resources>
                    </PasswordBox>

                    <!-- Confirm Password -->
                    <TextBlock Text="Confirm Password" FontSize="12" Foreground="#AED6F1"
                               FontFamily="Segoe UI" Margin="0,15,0,5"/>
                    <PasswordBox x:Name="TxtConfirmPassword" Height="40" FontSize="14"
                                 FontFamily="Segoe UI" Padding="10,0,0,0" VerticalContentAlignment="Center"
                                 Background="#1A3C5E" Foreground="White" BorderThickness="0"
                                 PasswordChar="*" CaretBrush="#5DADE2">
                        <PasswordBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </PasswordBox.Resources>
                    </PasswordBox>

                    <!-- Role -->
                    <TextBlock Text="Role" FontSize="12" Foreground="#AED6F1"
                               FontFamily="Segoe UI" Margin="0,15,0,5"/>
                    <ComboBox x:Name="CmbRole" Height="40" FontSize="14"
                              FontFamily="Segoe UI" Padding="10,0,0,0" VerticalContentAlignment="Center"
                              Background="#1A3C5E" Foreground="White" BorderThickness="0"
                              SelectedIndex="0">
                        <ComboBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </ComboBox.Resources>
                        <ComboBoxItem Content="Officer" Foreground="White" Background="#1A3C5E"/>
                        <ComboBoxItem Content="Admin" Foreground="White" Background="#1A3C5E"/>
                    </ComboBox>

                    <!-- Error Message -->
                    <TextBlock x:Name="LblError" FontSize="11" Foreground="#E74C3C"
                               FontFamily="Segoe UI" Margin="0,10,0,0" Visibility="Collapsed"
                               TextWrapping="Wrap"/>

                    <!-- Register Button -->
                    <Button x:Name="BtnRegister" Content="Create Account" Height="44" FontSize="14"
                            FontWeight="SemiBold" FontFamily="Segoe UI"
                            Background="#27AE60" Foreground="White" BorderThickness="0"
                            Margin="0,20,0,0" Cursor="Hand" Click="BtnRegister_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Back to Login Link -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,20">
                        <TextBlock Text="Already have an account? " FontSize="12"
                                   Foreground="#7FB3D3" FontFamily="Segoe UI"/>
                        <TextBlock Text="Sign in" FontSize="12" Foreground="#5DADE2"
                                   FontFamily="Segoe UI" Cursor="Hand"
                                   MouseDown="LblLogin_MouseDown"
                                   TextDecorations="Underline"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Close Button -->
            <Button Grid.Row="2" Content="Back" Height="30" FontSize="11"
                    FontFamily="Segoe UI" Background="Transparent" Foreground="#7FB3D3"
                    BorderThickness="0" HorizontalAlignment="Center" Cursor="Hand"
                    Click="BtnBack_Click"/>
        </Grid>
    </Border>
</Window>
