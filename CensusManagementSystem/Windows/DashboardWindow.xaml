<Window x:Class="CensusManagementSystem.Windows.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard - Census Management System"
        WindowStartupLocation="CenterScreen"
        Width="1100" Height="700"
        MinWidth="900" MinHeight="600"
        Background="#0B1F33">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0F2B46" CornerRadius="0,15,15,0" Margin="0,8,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,15,0,0">
                    <Border Width="40" Height="40" CornerRadius="20" Background="#1A5276">
                        <TextBlock Text="&#x1F4CA;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Census Manager" FontSize="12" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center" FontFamily="Segoe UI" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="10,10,10,0">
                    <Button x:Name="NavDashboard" Content="  Dashboard" Height="42" FontSize="13"
                            FontFamily="Segoe UI" Background="#1A5276" Foreground="White"
                            BorderThickness="0" HorizontalContentAlignment="Left"
                            Click="NavDashboard_Click" Cursor="Hand" Margin="0,0,0,4">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="NavArea" Content="  Area Management" Height="42" FontSize="13"
                            FontFamily="Segoe UI" Background="Transparent" Foreground="#AED6F1"
                            BorderThickness="0" HorizontalContentAlignment="Left"
                            Click="NavArea_Click" Cursor="Hand" Margin="0,0,0,4">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="NavHousehold" Content="  Households" Height="42" FontSize="13"
                            FontFamily="Segoe UI" Background="Transparent" Foreground="#AED6F1"
                            BorderThickness="0" HorizontalContentAlignment="Left"
                            Click="NavHousehold_Click" Cursor="Hand" Margin="0,0,0,4">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="NavCitizen" Content="  Citizens" Height="42" FontSize="13"
                            FontFamily="Segoe UI" Background="Transparent" Foreground="#AED6F1"
                            BorderThickness="0" HorizontalContentAlignment="Left"
                            Click="NavCitizen_Click" Cursor="Hand" Margin="0,0,0,4">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="NavReports" Content="  Reports" Height="42" FontSize="13"
                            FontFamily="Segoe UI" Background="Transparent" Foreground="#AED6F1"
                            BorderThickness="0" HorizontalContentAlignment="Left"
                            Click="NavReports_Click" Cursor="Hand" Margin="0,0,0,4">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- User Info & Logout -->
                <StackPanel Grid.Row="2" Margin="10,0,10,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="30" Height="30" CornerRadius="15" Background="#1A5276">
                            <TextBlock Text="&#x1F464;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="LblUser" Text="Admin" FontSize="11" FontWeight="SemiBold"
                                       Foreground="White" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="LblRole" Text="Admin" FontSize="9"
                                       Foreground="#7FB3D3" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="  Logout" Height="34" FontSize="12"
                            FontFamily="Segoe UI" Background="#922B21" Foreground="White"
                            BorderThickness="0" Click="BtnLogout_Click" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="#0F2B46" CornerRadius="12" Padding="20,0,20,0">
                <Grid>
                    <TextBlock Text="Dashboard" FontSize="20" FontWeight="SemiBold"
                               Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblDateTime" Text="" FontSize="11"
                               Foreground="#7FB3D3" FontFamily="Segoe UI"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Content Frame -->
            <Border x:Name="ContentBorder" Grid.Row="1" Background="#0F2B46" CornerRadius="12" Margin="0,8,0,0">
                <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden" Margin="15"/>
            </Border>
        </Grid>
    </Grid>
</Window>
